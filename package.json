{
  "name": "interview-project",
  "version": "0.1.0",
  "private": true,
  "description": "A NestJS interview starter with feature-oriented Diplomat boundaries.",
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=26.7.0 <27",
    "npm": ">=11 <12"
  },
  "scripts": {
    "postinstall": "prisma generate",
    "build": "prisma generate && nest build",
    "start": "node --env-file=.env dist/main.js",
    "start:dev": "node --env-file=.env node_modules/@nestjs/cli/bin/nest.js start --watch",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js --selectProjects unit --runInBand",
    "test:integration": "node scripts/test-database.mjs integration",
    "test:e2e": "node scripts/test-database.mjs e2e",
    "test:all": "npm test && node scripts/test-database.mjs integration e2e",
    "test:architecture": "depcruise src --config .dependency-cruiser.cjs",
    "db:up": "docker compose up -d --wait postgres postgres-test",
    "db:down": "docker compose stop postgres postgres-test",
    "db:generate": "prisma generate",
    "db:migrate": "node --env-file=.env node_modules/prisma/build/index.js migrate deploy",
    "db:migrate:dev": "node --env-file=.env node_modules/prisma/build/index.js migrate dev",
    "verify": "npm run format:check && npm run lint && npm run typecheck && npm run test:architecture && npm run test:all && npm run build",
    "auth:seed": "npm run build && node scripts/provision-demo.mjs",
    "test:logic": "npm test -- --testPathPatterns=/logic/",
    "test:adapters": "npm test -- --testPathPatterns=/adapters/"
  },
  "dependencies": {
    "@nestjs/common": "12.4.2",
    "@nestjs/core": "12.4.2",
    "@nestjs/platform-express": "12.4.2",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "jose": "6.2.17",
    "pg": "8.23.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@nestjs/cli": "12.0.12",
    "@nestjs/testing": "12.4.2",
    "@types/express": "5.0.6",
    "@types/jest": "30.0.0",
    "@types/node": "26.6.6",
    "@types/pg": "8.23.1",
    "@types/supertest": "7.2.1",
    "dependency-cruiser": "18.7.2",
    "eslint": "10.14.0",
    "eslint-config-prettier": "10.1.8",
    "jest": "30.5.2",
    "prettier": "3.9.10",
    "prisma": "7.10.1",
    "supertest": "7.3.2",
    "ts-jest": "29.4.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.2"
  }
}
