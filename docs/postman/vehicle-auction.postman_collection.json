{
  "info": {
    "_postman_id": "7fbb8fdc-5a5d-4f46-a1cc-681aed354e29",
    "name": "Vehicle Auction Interview API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Import the companion Local environment, fill its passwords, and select it before sending requests. Milestones one through five are complete: health, login, creation, listing, activation, bidding, highest bids, and winner selection are available. Run folders in order on a fresh auction. The bidding scenario places equal bids and checks that the earlier bid remains the leader. Winner checks can be repeated after the deadline without changing server time. Apply current migrations and provision local accounts first. Write requests modify local application data. No credentials or saved response tokens are included."
  },
  "item": [
    {
